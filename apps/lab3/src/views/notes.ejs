<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Notes</title>
  <link rel="stylesheet" href="/stylesheets/styles.css" />
  <link rel="stylesheet" href="/stylesheets/notes.css" />
  <script>
    function updateLoadAction() {
      const method = document.getElementById("loadMethod").value;
      document.getElementById("loadForm").action = `/notes/${method}`;
    }

    function updateAddAction() {
      const method = document.getElementById("addMethod").value;
      document.getElementById("addForm").action = `/notes/add-${method}`;
    }
  </script>
</head>

<body>

  <header>
    <nav class="navbar">
      <h1 class="logo">Brigade №28</h1>
      <ul class="nav-links">
        <li><a href="/">Home page</a></li>
          <li><a href="/notes/sync/">Notes</a></li>
      </ul>
    </nav>
  </header>

  <div class=" container">
            <div class="left-section">
              <h2>Choose Retrieval Method</h2>
              <form id="loadForm" action="/notes/sync" method="GET">
                <select id="loadMethod" name="method" onchange="updateLoadAction()">
                  <option value="sync">Sync</option>
                  <option value="callback">Callback</option>
                  <option value="promise">Promise</option>
                  <option value="async">Async/Await</option>
                </select>
                <button type="submit">Load Notes</button>
              </form>

              <h2>Add a Note</h2>
              <form id="addForm" action="/notes/add-sync" method="POST">
                <input type="text" name="title" placeholder="Title" required>
                <textarea name="content" placeholder="Enter your note" required></textarea>
                <select id="addMethod" name="method" onchange="updateAddAction()">
                  <option value="sync">Sync</option>
                  <option value="callback">Callback</option>
                  <option value="promise">Promise</option>
                  <option value="async">Async/Await</option>
                </select>
                <button type="submit">Add Note</button>
              </form>
            </div>

            <div class="right-section">
              <h2>Notes List</h2>
              <div class="notes-container">
                <% notes.forEach(note => { %>
                <div class="note-card">
                  <div class="note-header">
                    <h3 class="note-title"><%= note.title %></h3>
                    <span class="note-method">Retrieved using: <%= method %></span>
                  </div>
                  <p class="note-content"><%= note.content %></p>
                  <div class="note-footer">
                    <form action="/notes/delete/<%= note.id %>" method="POST">
                      <input type="hidden" name="method" value="<%= method %>">
                      <button type="submit" class="note-delete">Delete</button>
                    </form>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

            <footer>
              <p>&copy; 2025 Бригада. Усі права захищені.</p>
            </footer>

</body>

</html>